---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostList from '@/components/PostList.astro';
import andrew from '@/assets/images/andrew.webp';

const posts = await getCollection('blog');
---

<BaseLayout>
  <div class="content">
    <div class="hero">
      <Image class="hero-image" src={andrew} alt="andrew" />
      <div class="hero-text">
        <h1>Engineering for Creators</h1>
        <p>
          I'm a software engineer building tools for people working in music,
          tech, and creative spaces. I work across audio, web, and infrastructure
          to solve technical problems and improve the way creative work gets done.
        </p>
      </div>
    </div>
    {posts.length > 0 && (
      <h2>blog</h2> 
      <PostList />
    )}
  </div>
</BaseLayout>

<style>
  .content {
    max-width: 760px;
    margin-inline: auto;
  }

  .hero {
    display: flex;
    align-items: center;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .hero-image {
    flex: 0 0 30%;
    max-width: 300px;
    width: 100%;
    height: auto;
  }

  @media (max-width: 768px) {
    .hero {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
