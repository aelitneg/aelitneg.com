---
import ThemeToggle from '@/components/ThemeToggle.astro';
---

<header>
  <div class="logo">
    <a href="/">
      <div class="heading">aelitneg</div>
    </a>
    <div class="subheading">Andrew Gentile</div>
  </div>
  <ThemeToggle />
</header>

<style>
  header {
    background-color: inherit;
    display: flex;
    align-items: center;
    padding: 0.5rem;
  }
  .logo {
    flex: 1;
  }

  .logo .heading {
    font-size: 1.5rem;
    font-weight: bold;
  }

  .logo .subheading {
    font-weight: lighter;
    font-size: var(--font-size-sm);
  }

  .logo a,
  .logo a:visited {
    color: unset;
    text-decoration: none;
  }
</style>
